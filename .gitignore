# Go build output
/bin/
# Root-level `go build ./cmd/panewire` output. Anchored so the cmd/panewire
# package directory is unaffected.
/panewire
*.test
*.out

# Coverage and profiling
coverage.out
coverage.html
*.prof

# Local databases and runtime state
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.panewire/
# XDG state written when HOME points at a checkout (fleet events carry host names).
/.local/
# Per-project state the cmd (commandcode) harness writes into a worker's
# checkout. Untracked, it makes the node refuse to reuse the worktree as dirty.
/.commandcode/

# macOS and editor files
.DS_Store
.idea/
.vscode/

# Fleet Alloy credentials stay local.
deploy/alloy/loki.env
