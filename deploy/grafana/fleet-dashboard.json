{
  "uid": "fleet-observability",
  "title": "Fleet observability",
  "tags": [
    "fleet",
    "fleet-events"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "fleet-event v1 lines from panewire, panewire and mergewake (panewire deploy/alloy/README.md, Fleet events).",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Spawn refusals by host and reason",
      "description": "중앙 hub host ncp에서 기록한 최종 spawn 거절만 집계합니다. 노드에서 같은 kind로 남긴 중간 거절은 제외하고, 구형 runtug 이벤트도 포함합니다.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, reason) (count_over_time({source=\"fleet_events\", host=\"ncp\", tool=~\"runtug|panewire\", kind=\"spawn\", outcome=~\"refused|failed\"} | json reason=\"reason\" | label_format reason=`{{ if .reason }}{{ .reason }}{{ else }}unspecified{{ end }}` [$__auto]))",
          "legendFormat": "{{host}} {{reason}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Placements by chosen host and ranking",
      "description": "request_id가 있는 허브 placement 기록만 집계합니다. 같은 job의 request_id 없는 노드 echo와 직접 로컬 스폰 기록은 아래 별도 패널에 표시합니다. reason은 허브 결정 규칙입니다.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (chosen, reason) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=\"placement\", outcome=\"placed\"} | json chosen=\"chosen\", reason=\"reason\", request_id=\"request_id\" | request_id != \"\" [$__auto]))",
          "legendFormat": "{{chosen}} by {{reason}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Review outcomes",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, outcome, reason) (count_over_time({source=\"fleet_events\", tool=\"mergewake\", kind=~\"reviewer|review\"} | json reason=\"reason\" [$__auto]))",
          "legendFormat": "{{kind}} {{outcome}} {{reason}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reviewer failures by reviewer",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (reviewer, host) (count_over_time({source=\"fleet_events\", tool=\"mergewake\", kind=\"reviewer\", outcome=\"failed\"} | regexp \"reviewer=(?P<reviewer>[^ \\\"]+)\" [$__auto]))",
          "legendFormat": "{{reviewer}} via {{host}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node spawn refusals by reason",
      "description": "노드 spawn 거절만 표시합니다(outcome=refused 또는 failed). 성공한 outcome=ok 행은 제외합니다.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, reason) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=\"node_spawn\", outcome=~\"refused|failed\"} | json reason=\"reason\" [$__auto]))",
          "legendFormat": "{{host}} {{reason}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Quota observation age (minutes) at refusal",
      "description": "Age of the shared quota observation each time it refused a target host; -1 means never observed.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "max by (target, pool) (max_over_time({source=\"fleet_events\", kind=\"quota_observation\"} | regexp \"target=(?P<target>[^ \\\"]+) pool=(?P<pool>[^ \\\"]+) age_min=(?P<age_min>-?[0-9]+)\" | unwrap age_min [$__auto]))",
          "legendFormat": "{{target}} {{pool}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent fleet failures",
      "description": "Every refusal and failure line; open a line for job, reason and the redacted detail.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "{source=\"fleet_events\", outcome=~\"refused|failed|missing|stale|unusable\"}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Placement refusals by reason",
      "description": "placement refusal counts by host and reason.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, reason) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=\"placement\", outcome=\"refused\"} | json reason=\"reason\", request_id=\"request_id\" | request_id != \"\" | label_format reason=`{{ if .reason }}{{ .reason }}{{ else }}unspecified{{ end }}` [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{host}} {{kind}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Spawn stuck and held by branch",
      "description": "spawn outcome=stuck와 spawn_held branch를 별도 시리즈로 표시합니다.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, reason) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=\"spawn\", outcome=\"stuck\"} | json reason=\"reason\" [$__auto]))",
          "legendFormat": "{{host}} stuck {{reason}}",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, outcome, reason) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=\"spawn_held\"} | json reason=\"reason\" [$__auto]))",
          "legendFormat": "{{host}} held {{outcome}} {{reason}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Quota shadow agreement by kind",
      "description": "Quota shadow agreement outcomes by event kind over time.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, outcome) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=~\"quota_gate_shadow|quota_pools_shadow\", outcome=~\"agree|reason_differs|disagree\"} [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{host}} {{kind}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Placement candidate exclusion records",
      "description": "배치 후보 배열에 제외 결과가 하나 이상 있는 이벤트를 한 줄씩 보여 줍니다. LogQL은 candidates/selection 배열을 후보별 행으로 펼치지 못하므로 후보 호스트·결과별 집계는 제공하지 않고 원본 배열을 표시합니다.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "{source=\"fleet_events\", tool=\"panewire\", kind=\"placement\"} |~ \"\\\"outcome\\\":\\\"(different_account|not_chosen|spawn_disabled|excluded_host|missing_capability|not_accepting|repo_unmapped|disconnected|launch_backoff|login_missing|quota_refused|missing_tags|harness_missing|harness_version|dialog_pending|brief_unavailable|toolchain_missing|role_not_accepted|grade_not_accepted|deferred_over_threshold|refused_rc_|cwd_unmapped|panewire_missing|brief_doc_unavailable)\" | json candidates=\"candidates\", selection=\"selection\", request_id=\"request_id\" | request_id != \"\" | line_format \"host={{.host}} outcome={{.outcome}} candidates={{.candidates}} selection={{.selection}}\"",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Placement decisions: placed vs final refusals by host",
      "description": "Placement decision outcomes by emitting host: placed vs final refused. This is not a completion count; no completion event is emitted today.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, outcome) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=\"placement\", outcome=~\"placed|refused\"} | json request_id=\"request_id\" | request_id != \"\" [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{host}} {{kind}} {{outcome}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "node-local placement records (direct spawn + hub spawn node record)",
      "description": "request_id가 없는 placement 성공 기록입니다. 직접 로컬 스폰과 허브 스폰의 노드 실행 기록이 함께 표시되며, 허브 배치 성공 집계에는 포함하지 않습니다.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, reason) (count_over_time({source=\"fleet_events\", tool=\"panewire\", kind=\"placement\", outcome=\"placed\"} | json reason=\"reason\", request_id=\"request_id\" | request_id = \"\" [$__auto]))",
          "legendFormat": "{{host}} {{reason}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
