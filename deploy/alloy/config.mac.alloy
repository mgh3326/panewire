// Fleet log shipper for the already-running macOS personal host; file sources only (no journald).
// Source configuration was captured on 2026-09-02; preserve its runtime behavior.
// Credentials are repository-external: launchd plist EnvironmentVariables, never this repository.
loki.write "cloud" {
	endpoint {
		url = sys.env("LOKI_URL") + "/loki/api/v1/push"

		basic_auth {
			username = sys.env("LOKI_USER")
			password = sys.env("LOKI_TOKEN")
		}
	}
	external_labels = {
		machine_id = sys.env("MACHINE_ID"),
		env        = "prod",
	}
}

// Node metrics are sent to the hosted Prometheus remote-write endpoint, never
// Loki. The host identity is injected by launchd so a copied config cannot
// silently report itself as another machine. Extra collectors are opt-in per
// host through ALLOY_ENABLE_COLLECTORS as a JSON list, e.g. ["thermal"] or
// ["textfile"]; unset means no extra collectors. Thermal needs hardware CPU
// power status and errors every scrape on Macs without it, so it stays off
// by default. Enabling "textfile" also requires FLEET_TEXTFILE_DIR, as in
// config.linux.alloy. Per-process CPU and memory arrive through that textfile
// directory from proc-metrics.sh (macOS has no /proc for the process exporter).
prometheus.exporter.unix "node" {
	enable_collectors = encoding.from_json(coalesce(sys.env("ALLOY_ENABLE_COLLECTORS"), "[]"))
	disable_collectors = encoding.from_json(coalesce(sys.env("ALLOY_DISABLE_COLLECTORS"), "[]"))

	textfile {
		directory          = sys.env("FLEET_TEXTFILE_DIR")
	}
}

discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "machine_id"
		replacement  = sys.env("MACHINE_ID")
	}
}

prometheus.remote_write "fleet" {
	endpoint {
		url = sys.env("PROM_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("PROM_REMOTE_WRITE_USER")
			password = sys.env("PROM_REMOTE_WRITE_TOKEN")
		}
	}
}

prometheus.scrape "node" {
	targets    = discovery.relabel.node.output
	forward_to = [prometheus.remote_write.fleet.receiver]
}

local.file_match "runtime" {
	path_targets = [
		{__path__ = "${HOME}/services/auto_trader/logs/*.log", source = "auto_trader"},
		{__path__ = "${HOME}/services/prefect/logs/*.log", source = "prefect"},
		{__path__ = "${HOME}/.local/state/watch-alert-relay/*.log", source = "watch-alert-relay"},
		{__path__ = "${HOME}/.local/state/fill-event-triage/*.log", source = "fill-event-triage"},
	]
	sync_period = "30s"
}

loki.relabel "files" {
	forward_to = []

	rule {
		source_labels = ["__path__"]
		regex         = ".*/([^/]+)$"
		target_label  = "file"
	}
}

loki.source.file "runtime" {
	targets       = local.file_match.runtime.targets
	forward_to    = [loki.write.cloud.receiver]
	tail_from_end = true
}
