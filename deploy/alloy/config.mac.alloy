// Fleet log shipper for the already-running macOS personal host; file sources only (no journald).
// Source configuration was captured on 2026-09-02; preserve its runtime behavior.
// Credentials are repository-external: launchd plist EnvironmentVariables, never this repository.
loki.write "cloud" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
    basic_auth {
      username = sys.env("LOKI_USER")
      password = sys.env("LOKI_TOKEN")
    }
  }
  external_labels = {
    machine_id = "mac-personal",
    env        = "prod",
  }
}
local.file_match "runtime" {
  path_targets = [
    { __path__ = "${HOME}/services/auto_trader/logs/*.log", source = "auto_trader" },
    { __path__ = "${HOME}/services/prefect/logs/*.log", source = "prefect" },
    { __path__ = "${HOME}/.local/state/watch-alert-relay/*.log", source = "watch-alert-relay" },
    { __path__ = "${HOME}/.local/state/fill-event-triage/*.log", source = "fill-event-triage" },
  ]
  sync_period = "30s"
}
loki.relabel "files" {
  forward_to = []
  rule {
    source_labels = ["__path__"]
    regex         = ".*/([^/]+)$"
    target_label  = "file"
  }
}
loki.source.file "runtime" {
  targets       = local.file_match.runtime.targets
  forward_to    = [loki.write.cloud.receiver]
  tail_from_end = true
}
