// Fleet log shipper for the already-running Linux fleet (NCP, OCI, and RPi).
// Source configuration was captured on 2026-09-02; preserve its runtime behavior.
// Credentials are repository-external: local loki.env, loaded through the systemd EnvironmentFile.
loki.write "cloud" {
	endpoint {
		url = sys.env("LOKI_URL") + "/loki/api/v1/push"

		basic_auth {
			username = sys.env("LOKI_USER")
			password = sys.env("LOKI_TOKEN")
		}
	}
	external_labels = {
		machine_id = sys.env("MACHINE_ID"),
		env        = "prod",
	}
}

// node_exporter-compatible host metrics for hub placement. MACHINE_ID is an
// EnvironmentFile contract, not a literal host label. Extra collectors are
// opt-in per host through ALLOY_ENABLE_COLLECTORS as a JSON list. Hosts that
// enable "textfile" must also set FLEET_TEXTFILE_DIR; the unix exporter then
// exposes *.prom files from that directory as metrics (app gauges such as
// session and quota counters). Both unset means no extra collectors.
prometheus.exporter.unix "node" {
	enable_collectors = encoding.from_json(coalesce(sys.env("ALLOY_ENABLE_COLLECTORS"), "[]"))
	disable_collectors = encoding.from_json(coalesce(sys.env("ALLOY_DISABLE_COLLECTORS"), "[]"))

	textfile {
		directory = sys.env("FLEET_TEXTFILE_DIR")
	}
}

discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "machine_id"
		replacement  = sys.env("MACHINE_ID")
	}
}

prometheus.remote_write "fleet" {
	endpoint {
		url = sys.env("PROM_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("PROM_REMOTE_WRITE_USER")
			password = sys.env("PROM_REMOTE_WRITE_TOKEN")
		}
	}
}

prometheus.scrape "node" {
	targets    = discovery.relabel.node.output
	forward_to = [prometheus.remote_write.fleet.receiver]
}

// Per-process CPU and memory, grouped by process name (kernel command name,
// at most 15 bytes) so one program's workers sum into a single series set.
// cmdline ".+" skips kernel threads. Only three metric families leave the
// host -- CPU seconds, resident memory, process count -- because the free
// Grafana Cloud tier allows 10k active series for the whole account. See
// README "Process metrics" for the series budget and why Linux is not capped
// to a top-N here.
prometheus.exporter.process "procs" {
	track_children      = false
	gather_smaps        = false
	remove_empty_groups = true

	matcher {
		name    = "{{.Comm}}"
		cmdline = [".+"]
	}
}

discovery.relabel "procs" {
	targets = prometheus.exporter.process.procs.targets

	rule {
		target_label = "machine_id"
		replacement  = sys.env("MACHINE_ID")
	}
}

// Allowlist, not a denylist: anything the exporter adds later stays local.
// Rows are "<__name__>;<memtype>"; only the resident memory type is kept.
// Relabel regexes are fully anchored, so "up;" cannot match a name ending in "up".
prometheus.relabel "procs" {
	forward_to = [prometheus.remote_write.fleet.receiver]

	rule {
		source_labels = ["__name__", "memtype"]
		regex         = "up;|namedprocess_namegroup_(cpu_seconds_total|num_procs);|namedprocess_namegroup_memory_bytes;resident"
		action        = "keep"
	}
}

prometheus.scrape "procs" {
	targets    = discovery.relabel.procs.output
	forward_to = [prometheus.relabel.procs.receiver]
}

// systemd journal (units, kernel, sshd, timers)
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_syslog_identifier"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.source.journal "journal" {
	max_age       = "12h"
	relabel_rules = loki.relabel.journal.rules
	labels        = {source = "journal"}
	forward_to    = [loki.write.cloud.receiver]
}

// BEGIN docker containers
// docker containers (at-api, at-scheduler, broker-edge, gatewayd, pg17, redis, dev kit …)
discovery.docker "local" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
	targets = discovery.docker.local.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "docker" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.docker.output
	labels     = {source = "docker"}
	forward_to = [loki.write.cloud.receiver]
}
// END docker containers
