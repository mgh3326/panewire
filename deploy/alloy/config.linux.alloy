// Fleet log shipper for the already-running Linux fleet (NCP, OCI, and RPi).
// Source configuration was captured on 2026-09-02; preserve its runtime behavior.
// Credentials are repository-external: local loki.env, loaded through the systemd EnvironmentFile.
loki.write "cloud" {
	endpoint {
		url = sys.env("LOKI_URL") + "/loki/api/v1/push"

		basic_auth {
			username = sys.env("LOKI_USER")
			password = sys.env("LOKI_TOKEN")
		}
	}
	external_labels = {
		machine_id = sys.env("MACHINE_ID"),
		env        = "prod",
	}
}

// node_exporter-compatible host metrics for hub placement. MACHINE_ID is an
// EnvironmentFile contract, not a literal host label. Extra collectors are
// opt-in per host through ALLOY_ENABLE_COLLECTORS as a JSON list. Hosts that
// enable "textfile" must also set FLEET_TEXTFILE_DIR; the unix exporter then
// exposes *.prom files from that directory as metrics (app gauges such as
// session and quota counters) and the per-process CPU/memory file written by
// proc-metrics.sh. The Alloy process exporter is deliberately not used: it
// cannot cap the number of series (see README). Both unset means no extra
// collectors.
prometheus.exporter.unix "node" {
	enable_collectors = encoding.from_json(coalesce(sys.env("ALLOY_ENABLE_COLLECTORS"), "[]"))
	disable_collectors = encoding.from_json(coalesce(sys.env("ALLOY_DISABLE_COLLECTORS"), "[]"))

	textfile {
		directory = sys.env("FLEET_TEXTFILE_DIR")
	}
}

discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "machine_id"
		replacement  = sys.env("MACHINE_ID")
	}
}

prometheus.remote_write "fleet" {
	endpoint {
		url = sys.env("PROM_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("PROM_REMOTE_WRITE_USER")
			password = sys.env("PROM_REMOTE_WRITE_TOKEN")
		}
	}
}

prometheus.scrape "node" {
	targets    = discovery.relabel.node.output
	forward_to = [prometheus.remote_write.fleet.receiver]
}

// systemd journal (units, kernel, sshd, timers)
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_syslog_identifier"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.source.journal "journal" {
	max_age       = "12h"
	relabel_rules = loki.relabel.journal.rules
	labels        = {source = "journal"}
	forward_to    = [loki.write.cloud.receiver]
}

// BEGIN docker containers
// docker containers (at-api, at-scheduler, broker-edge, gatewayd, pg17, redis, dev kit …)
discovery.docker "local" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
	targets = discovery.docker.local.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "docker" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.docker.output
	labels     = {source = "docker"}
	forward_to = [loki.write.cloud.receiver]
}
// END docker containers

// BEGIN fleet events
// Fleet events (fleet-event v1): panewire and mergewake each append
// one JSON object per line to <state home>/<tool>/events/fleet-events.jsonl
// (ts, host, tool, kind, job, outcome, reason, detail). FLEET_EVENTS_ROOT is
// the fleet user's state home; it defaults to $HOME/.local/state, which is
// right for a user launchd agent but not for the Linux alloy system user.
// Keep Linux targets explicit: globbing across tool directories can fail as a
// whole when the Alloy user cannot traverse one sibling directory. A tool
// missing from the list ships nothing here (see deploy/alloy/README.md, "Fleet events").
// Only host, os_host, tool, kind and outcome become labels; job, reason and
// detail stay in the line (query them with `| json`). The host label is the
// fleet machine id (MACHINE_ID), the id hk, Sentry and placement use; the
// writer's OS hostname from the line's host field moves to os_host. Without
// MACHINE_ID, host stays the OS hostname, as before. The rotated .1 generation is
// never matched, so no line ships twice. stage.limit caps a runaway writer
// at 0.5 lines/s per host (see README "Fleet events" for the volume budget).
local.file_match "fleet_events" {
	path_targets = [
		{__path__ = coalesce(sys.env("FLEET_EVENTS_ROOT"), sys.env("HOME") + "/.local/state") + "/panewire/events/fleet-events.jsonl", source = "fleet_events"},
		{__path__ = coalesce(sys.env("FLEET_EVENTS_ROOT"), sys.env("HOME") + "/.local/state") + "/mergewake/events/fleet-events.jsonl", source = "fleet_events"},
	]
	sync_period = "30s"
}

// No tail_from_end: a file without a stored position (first start, or the
// fresh file after a rotation) is read from its start, and a restart resumes
// from the positions file, so lines written while alloy was down still ship.
loki.source.file "fleet_events" {
	targets    = local.file_match.fleet_events.targets
	forward_to = [loki.process.fleet_events.receiver]
}

loki.process "fleet_events" {
	forward_to = [loki.write.cloud.receiver]

	stage.json {
		expressions = {
			ts      = "ts",
			host    = "host",
			os_host = "host",
			tool    = "tool",
			kind    = "kind",
			outcome = "outcome",
		}
	}

	stage.timestamp {
		source = "ts"
		format = "RFC3339Nano"
	}

	// A set MACHINE_ID becomes a literal template; an unset or empty one
	// leaves the host field from the line.
	stage.template {
		source   = "host"
		template = coalesce(sys.env("MACHINE_ID"), "{{ if .Value }}{{ .Value }}{{ end }}")
	}

	stage.labels {
		values = {
			host    = "",
			os_host = "",
			tool    = "",
			kind    = "",
			outcome = "",
		}
	}

	stage.label_drop {
		values = ["filename"]
	}

	stage.limit {
		rate  = 0.5
		burst = 200
		drop  = true
	}
}
// END fleet events
