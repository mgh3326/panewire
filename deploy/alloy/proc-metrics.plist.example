<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.panewire.proc-metrics</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/proc-metrics.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Same directory as FLEET_TEXTFILE_DIR in the Alloy plist. -->
    <key>FLEET_TEXTFILE_DIR</key>
    <string>__FLEET_TEXTFILE_DIR__</string>
  </dict>
  <!-- One run per interval; the script is not a daemon. -->
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
