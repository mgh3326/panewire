<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.alloy.fleet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/run-alloy.sh</string>
    <string>/opt/homebrew/bin/alloy</string>
    <string>/ABSOLUTE/PATH/TO/config.mac.alloy</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MACHINE_ID</key>
    <string>__MACHINE_ID__</string>
    <key>PROM_REMOTE_WRITE_URL</key>
    <string>__PROM_REMOTE_WRITE_URL__</string>
    <key>LOKI_URL</key>
    <string>__LOKI_URL__</string>
    <key>LOKI_USER</key>
    <string>__LOKI_USER__</string>
    <key>LOKI_TOKEN</key>
    <string>__LOKI_TOKEN__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
