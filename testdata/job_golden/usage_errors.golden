== step ["done" "-x"] rc=2
-- stdout
-- stderr
<cmd>: done requires a job id
== step ["done" "jw" "--report"] rc=2
-- stdout
-- stderr
<cmd>: --report requires a path
== step ["done" "jw" "--bogus"] rc=2
-- stdout
-- stderr
<cmd>: unknown done option '--bogus'
== step ["done" "nojob" "--report" "@ROOT@/reports/missing.md"] rc=2
-- stdout
-- stderr
<cmd>: done cannot find job.claim/job.spawned metadata: nojob
== step ["done" "jw" "--report" "@ROOT@/reports/missing.md"] rc=2
-- stdout
-- stderr
<cmd>: done requires an existing --report or report*.md in the job directory
== step ["escalate" "jw" "--question" "worker is not a builder"] rc=2
-- stdout
-- stderr
<cmd>: jw is not a builder claim with a parent lane (legacy captain alias is accepted)
== step ["escalate" "jb"] rc=2
-- stdout
-- stderr
<cmd>: escalate requires --question
== step ["escalate" "jb" "--question" "q" "--report" "@ROOT@/reports/missing.md"] rc=2
-- stdout
-- stderr
<cmd>: escalate requires an existing --report
== step ["joined" "jb" "--pr" "u" "--head" "h"] rc=2
-- stdout
-- stderr
<cmd>: joined requires --pr, --head and an existing --report
== step ["joined" "jb" "--pr" "" "--head" "h" "--report" "@ROOT@/reports/x.md"] rc=2
-- stdout
-- stderr
<cmd>: --pr requires a URL
== step ["escalate" "-h"] rc=0
